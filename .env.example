# ==============================================================================
# Conexión a la base de datos de Supabase.
#
# Ve al dashboard de tu proyecto en Supabase > botón "Connect" (arriba) >
# pestaña "ORMs" (o "Connection string" según la versión de la interfaz).
# Ahí verás varias opciones; copia estas dos:
# ==============================================================================

# 1) "Transaction pooler" (puerto 6543). Es la que usa la app en tiempo de
#    ejecución. Soporta IPv4, por lo que funciona en cualquier red.
#    IMPORTANTE: agrega "?pgbouncer=true" al final, como en el ejemplo.
DATABASE_URL="postgresql://postgres.biujmvbtplwsgmyhfxdx:Trencito123@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2) "Session pooler" (puerto 5432). Prisma la usa SOLO para crear/actualizar
#    tablas (prisma migrate). También soporta IPv4.
DIRECT_URL="postgresql://postgres.biujmvbtplwsgmyhfxdx:Trencito123@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Si tu contraseña tiene caracteres especiales (@ # $ % /), codifícalos en la URL
# (por ejemplo "@" se escribe "%40"), o mejor cámbiala por una sin símbolos
# especiales desde Supabase: Settings > Database > Reset database password.

# ==============================================================================
# Clave secreta para firmar los tokens JWT. Cambia este valor por uno propio y
# seguro (puedes generar uno con: openssl rand -base64 32).
# ==============================================================================
JWT_SECRET="ARLKABD2R9DnjtnNSG7p9ylZ7b/ecmrqLEAd36o4ubA="

# Puerto en el que corre el servidor local (Render/Railway lo sobrescriben automáticamente).
PORT=3000
